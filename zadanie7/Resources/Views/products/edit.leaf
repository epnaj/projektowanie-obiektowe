#extend("base"):
    #export("title"): Edycja produktu #endexport
    #export("body"):
        <form method="post" action="/web/products/#(product.id)/edit">
            <label>Name
                <input type="text" name="name" value="#(product.name)" required>
            </label>
            <label>Price
                <input type="number" step="0.01" name="price" value="#(product.price)" required>
            </label>
            <label>Description
                <textarea name="description">#(product.description)</textarea>
            </label>
            <label>Quantity
                <input type="number" name="quantity" value="#(product.quantity)" min="0" required>
            </label>
            <p>
                <button type="submit">Save cahnges</button>
                <a class="button" href="/web/products">Cancel</a>
            </p>
        </form>
    #endexport
#endextend
